{
  "name": "ctour",
  "version": "0.1.1",
  "description": "Maps and guided tours of your code, written by you, linking why to how",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alice088/cognitive-tours-forge.git"
  },
  "homepage": "https://github.com/Alice088/cognitive-tours-forge#readme",
  "bugs": {
    "url": "https://github.com/Alice088/cognitive-tours-forge/issues"
  },
  "keywords": [
    "cognitive-tours",
    "codebase",
    "code-map",
    "onboarding",
    "documentation",
    "architecture",
    "tours",
    "mcp",
    "local-first"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "ctour": "./dist/cli.mjs"
  },
  "files": [
    "dist/",
    ".next/standalone/",
    "!.next/standalone/tests/",
    "!.next/standalone/specs/",
    "!.next/standalone/docs/",
    "!.next/standalone/tours/",
    "!.next/standalone/resources/",
    "!.next/standalone/test-results/",
    "!.next/standalone/.tmp/",
    "!**/*.tgz",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "build:web": "next build",
    "build:cli": "esbuild cli/index.ts --bundle --platform=node --format=esm --outfile=dist/cli.mjs --banner:js='#!/usr/bin/env node' && node -e \"require('node:fs').chmodSync('dist/cli.mjs', 0o755)\" && node scripts/build-info.mjs",
    "build:pack": "node scripts/pack-standalone.mjs",
    "build:all": "node -e \"require('node:fs').rmSync('.next/standalone',{recursive:true,force:true})\" && npm run build:web && npm run build:pack && npm run build:cli",
    "prepublishOnly": "npm run typecheck && npm run test:unit && npm run build:all"
  },
  "dependencies": {
    "@xyflow/react": "^12.10.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "0.460.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zundo": "^2.3.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.1",
    "playwright": "^1.60.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
